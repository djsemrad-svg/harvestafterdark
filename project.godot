; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Harvest Afterdark"
config/description="A homestead at the end of the world."
run/main_scene="res://HarvestAfterdark.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Balance="*res://scripts/autoload/balance.gd"
Data="*res://scripts/autoload/data.gd"
Art="*res://scripts/autoload/art.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Game="*res://scripts/autoload/game.gd"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"mabel": "res://dialogue/characters/mabel.dch",
"marguerite": "res://dialogue/characters/marguerite.dch",
"tobias": "res://dialogue/characters/tobias.dch"
}
directories/dtl_directory={
"curio_mabel": "res://dialogue/curio_mabel.dtl",
"lantern_tobias": "res://dialogue/lantern_tobias.dtl",
"seed_fair_marguerite": "res://dialogue/seed_fair_marguerite.dtl"
}
layout/style_directory={}

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.04, 1)
2d/snap/snap_2d_transforms_to_pixel=true
